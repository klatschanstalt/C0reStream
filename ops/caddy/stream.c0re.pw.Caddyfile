stream.c0re.pw {
	root * /var/www/stream.c0re.pw

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'"
		Link "</llms.txt>; rel=\"service-doc\"; type=\"text/markdown\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/json\""
		-Server
	}

	@wants_markdown {
		path /
		header Accept *text/markdown*
	}
	handle @wants_markdown {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /llms.txt
		file_server
	}

	@wellknown_json {
		path /.well-known/ucp /.well-known/*.json /.well-known/mcp/*.json /.well-known/agent-skills/*.json
	}
	header @wellknown_json Content-Type "application/json; charset=utf-8"

	@static {
		path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.ico *.woff2 *.webmanifest
	}
	header @static Cache-Control "public, max-age=604800, immutable"

	header /index.html Cache-Control "no-cache, must-revalidate"

	# Isolated static distribution route. Served directly from the private
	# canonical tree, independent of the webroot symlink. No redirects, no auth.
	handle /distribution/* {
		vars dist_route "1"
		uri strip_prefix /distribution
		root * /var/lib/c0re-distribution/current

		@dist_apk path *.apk
		header @dist_apk >Content-Type "application/vnd.android.package-archive"

		@dist_json path *.json
		header @dist_json >Content-Type "application/json; charset=utf-8"

		@dist_sig path *.sig
		header @dist_sig >Content-Type "text/plain; charset=utf-8"

		@dist_sums path */SHA256SUMS
		header @dist_sums >Content-Type "text/plain; charset=utf-8"

		# Match both pre- and post-strip paths: header matchers are evaluated
		# before the uri rewrite is applied.
		@dist_releases path /distribution/releases/* /releases/*
		header @dist_releases Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}

		@dist_update path /distribution/update.json /update.json
		header @dist_update Cache-Control "no-cache, must-revalidate" {
			match status 2xx
		}

		@dist_resources path /distribution/resources/* /resources/*
		header @dist_resources Cache-Control "no-cache, must-revalidate" {
			match status 2xx
		}

		file_server
	}

	file_server

	handle_errors {
		# Distribution errors must stay real errors; never rewrite to /index.html.
		@dist_error expression `{http.vars.dist_route} == "1"`
		respond @dist_error "404 Not Found" 404

		@notfound expression `{http.error.status_code} == 404`
		rewrite @notfound /index.html
		file_server
	}
}
