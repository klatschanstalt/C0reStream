<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ native splash screen. No extra dependency and no artificial delay:
     the system shows the branded icon until the first app frame is drawn. -->
<resources>
    <style name="Theme.C0reStream" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/system_bar_color</item>
        <item name="android:navigationBarColor">@color/system_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@drawable/splash_background</item>

        <item name="android:windowSplashScreenBackground">@color/splash_background_color</item>
        <!-- Square, transparent brand mark; never the 1080x1920 splashscreen.png artwork. -->
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_app_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background_color</item>
    </style>
</resources>
